generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PENDING
  PAID
  CONFIRMED
  SOURCING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  USER_DROPPED
  EXPIRED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum CheckoutOperationState {
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaUploadStatus {
  CONFIRMED
  DELETE_PENDING
  ORPHANED
  ARCHIVED
}

model AdminUser {
  id               String               @id @default(cuid())
  email            String               @unique
  passwordHash     String
  displayName      String
  status           AdminStatus          @default(ACTIVE)
  failedLoginCount Int                  @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  roles            AdminUserRole[]
  sessions         AdminSession[]
  resetTokens      PasswordResetToken[]
  auditLogs        AuditLog[]
}

model AdminRole {
  id          String                @id @default(cuid())
  name        String                @unique
  description String?
  users       AdminUserRole[]
  permissions AdminRolePermission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model AdminPermission {
  id          String                @id @default(cuid())
  key         String                @unique
  description String?
  roles       AdminRolePermission[]
}

model AdminUserRole {
  userId String
  roleId String
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AdminRolePermission {
  roleId       String
  permissionId String
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  reason      String?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  createdAt   DateTime   @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model IdempotencyRecord {
  id          String    @id @default(cuid())
  scope       String
  key         String
  requestHash String
  response    Json?
  statusCode  Int?
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

model RateLimitRecord {
  id           String    @id @default(cuid())
  scope        String
  keyHash      String
  windowStart  DateTime
  count        Int       @default(1)
  blockedUntil DateTime?

  @@unique([scope, keyHash, windowStart])
}

model Product {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  name                 String
  internalCode         String                 @unique
  shortDescription     String
  fullDescription      String
  category             String                 @default("Kurti")
  taxInclusive         Boolean                @default(true)
  regularPricePaise    Int
  salePricePaise       Int?
  costPricePaise       Int?
  taxBasisPoints       Int                    @default(0)
  status               ProductStatus          @default(DRAFT)
  active               Boolean                @default(true)
  featured             Boolean                @default(false)
  bestseller           Boolean                @default(false)
  newArrival           Boolean                @default(false)
  badge                String?
  fabric               String
  fit                  String?
  occasions            String[]
  pattern              String?
  primaryColor         String?
  neckType             String?
  sleeveType           String?
  kurtiLength          String?
  transparency         String?
  lining               String?
  sideSlit             String?
  washCare             String[]
  modelHeightCm        Int?
  modelSizeWorn        String?
  fitIndicator         String?
  fitNote              String?
  countryOfOrigin      String?
  packageContents      String?
  shippingInfo         String
  dispatchDays         Int?
  weightGrams          Int?
  cancellationEligible Boolean                @default(true)
  codAvailableOverride Boolean?
  returnEligible       Boolean                @default(true)
  returnWindowDays     Int?
  seoTitle             String?
  seoDescription       String?
  searchKeywords       String[]
  searchVisible        Boolean                @default(true)
  indexable            Boolean                @default(true)
  sortPriority         Int                    @default(0)
  publishStartAt       DateTime?
  publishEndAt         DateTime?
  deletedAt            DateTime?
  version              Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  variants             ProductVariant[]
  media                ProductMedia[]
  measurements         ProductMeasurement[]
  tags                 ProductTagAssignment[]
  collections          CollectionProduct[]
  sources              ProductSource[]
  campaignProducts     CampaignProduct[]
  orderItems           OrderItem[]
  reviews              Review[]
  analytics            AnalyticsEvent[]

  @@index([status, active])
  @@index([featured])
  @@index([createdAt])
}

model ProductVariant {
  id                String                 @id @default(cuid())
  productId         String
  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String                 @unique
  color             String
  colorLabel        String
  colorHex          String?
  size              String
  position          Int                    @default(0)
  regularPricePaise Int?
  salePricePaise    Int?
  costPricePaise    Int?
  currentStock      Int                    @default(0)
  reservedStock     Int                    @default(0)
  lowStockThreshold Int                    @default(3)
  active            Boolean                @default(true)
  sourceAvailable   Boolean                @default(true)
  weightGrams       Int?
  mediaId           String?
  media             ProductMedia?          @relation("VariantPrimaryMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  assignedMedia     ProductMedia[]         @relation("MediaVariantAssignment")
  adjustments       InventoryAdjustment[]
  reservations      InventoryReservation[]
  orderItems        OrderItem[]

  @@unique([productId, color, size])
  @@index([productId, active])
}

model ProductMedia {
  id                 String            @id @default(cuid())
  productId          String
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type               MediaType
  resourceType       String            @default("image")
  format             String
  version            Int
  folder             String
  cloudinaryPublicId String            @unique
  secureUrl          String
  altText            String
  position           Int               @default(0)
  isPrimary          Boolean           @default(false)
  color              String?
  assignedVariantId  String?
  assignedVariant    ProductVariant?   @relation("MediaVariantAssignment", fields: [assignedVariantId], references: [id], onDelete: SetNull)
  uploadStatus       MediaUploadStatus @default(CONFIRMED)
  width              Int?
  height             Int?
  bytes              Int?
  mimeType           String?
  createdByAdminId   String
  orphanReason       String?
  deletedAt          DateTime?
  variants           ProductVariant[]  @relation("VariantPrimaryMedia")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([productId, position])
  @@index([assignedVariantId])
  @@index([uploadStatus, deletedAt])
}

model ProductMeasurement {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size             String
  bustTenthsIn     Int
  waistTenthsIn    Int
  hipTenthsIn      Int
  shoulderTenthsIn Int?
  lengthTenthsIn   Int
  sleeveTenthsIn   Int?

  @@unique([productId, size])
}

model ProductTag {
  id          String                 @id @default(cuid())
  name        String                 @unique
  slug        String                 @unique
  assignments ProductTagAssignment[]
}

model ProductTagAssignment {
  productId String
  tagId     String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Collection {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String?
  imageUrl    String?
  active      Boolean              @default(true)
  publishedAt DateTime?
  position    Int                  @default(0)
  products    CollectionProduct[]
  campaigns   CampaignCollection[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model ProductSource {
  id                   String        @id @default(cuid())
  productId            String
  product              Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierName         String
  platform             String?
  supplierUrl          String?
  sourceListingId      String?
  sourceSku            String?
  variantMapping       Json?
  sourcePricePaise     Int?
  lastCheckedAt        DateTime?
  availabilityState    String?
  expectedDeliveryDays Int?
  backupSource         Boolean       @default(false)
  notes                String?
  active               Boolean       @default(true)
  sourceOrders         SourceOrder[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model InventoryAdjustment {
  id            String         @id @default(cuid())
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  delta         Int
  previousStock Int?
  newStock      Int?
  reason        String
  reference     String?
  adminUserId   String?
  createdAt     DateTime       @default(now())

  @@index([variantId, createdAt])
}

model InventoryReservation {
  id          String            @id @default(cuid())
  variantId   String
  variant     ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId String            @unique
  orderItem   OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  releasedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([variantId, expiresAt])
}

model StoreSetting {
  id                          String   @id @default("default")
  storeName                   String   @default("Ruvaya")
  supportEmail                String?
  whatsappNumber              String?
  businessAddress             String?
  currency                    String   @default("INR")
  timezone                    String   @default("Asia/Kolkata")
  orderPrefix                 String   @default("RUV")
  shippingChargePaise         Int      @default(0)
  freeShippingThresholdPaise  Int?
  lowStockThreshold           Int      @default(3)
  paymentSessionExpiryMinutes Int      @default(30)
  reservationMinutes          Int      @default(20)
  returnWindowDays            Int      @default(7)
  maintenanceMode             Boolean  @default(false)
  storefrontUrl               String?
  ga4MeasurementId            String?
  metaPixelId                 String?
  version                     Int      @default(1)
  updatedAt                   DateTime @updatedAt
}

model StorefrontConfigVersion {
  id          String    @id @default(cuid())
  version     Int       @unique
  content     Json
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model HomepageVersion {
  id          String    @id @default(cuid())
  version     Int       @unique
  content     Json
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model NavigationVersion {
  id          String    @id @default(cuid())
  version     Int       @unique
  content     Json
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model ContentPage {
  id        String               @id @default(cuid())
  slug      String               @unique
  title     String
  active    Boolean              @default(true)
  versions  ContentPageVersion[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ContentPageVersion {
  id          String      @id @default(cuid())
  pageId      String
  page        ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version     Int
  content     Json
  status      String      @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime    @default(now())

  @@unique([pageId, version])
}

model MediaAsset {
  id        String    @id @default(cuid())
  publicId  String    @unique
  secureUrl String
  type      MediaType
  folder    String
  altText   String?
  metadata  Json?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}

model RevalidationLog {
  id         String   @id @default(cuid())
  reason     String
  paths      String[]
  tags       String[]
  response   Json?
  success    Boolean
  retryCount Int      @default(0)
  createdAt  DateTime @default(now())
}

model Customer {
  id        String            @id @default(cuid())
  email     String?
  phone     String?
  name      String
  flags     String[]
  notes     String?
  addresses CustomerAddress[]
  orders    Order[]
  reviews   Review[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([email])
  @@index([phone])
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  email       String?
  addressLine String
  locality    String?
  landmark    String?
  city        String
  state       String
  pincode     String
  createdAt   DateTime @default(now())
}

// Customer-facing login identity — separate from `Customer`, which remains a
// per-order shipping/contact snapshot. An Account may place many orders,
// each still creating its own `Customer` row (so shipping details can differ
// order to order, e.g. gifts), linked back via `Order.accountId`.
model Account {
  id           String                      @id @default(cuid())
  email        String                      @unique
  passwordHash String?
  googleId     String?                     @unique
  name         String
  phone        String?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
  sessions     AccountSession[]
  resetTokens  AccountPasswordResetToken[]
  addresses    AccountAddress[]
  orders       Order[]
}

model AccountSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([accountId, expiresAt])
}

model AccountPasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId, expiresAt])
}

model AccountAddress {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label       String?
  fullName    String
  phone       String
  email       String?
  addressLine String
  locality    String?
  landmark    String?
  city        String
  state       String
  pincode     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([accountId])
}

model Order {
  id                         String                 @id @default(cuid())
  orderNumber                String                 @unique
  secureTokenHash            String?                @unique
  paymentCapabilityHash      String?                @unique
  paymentCapabilityExpiresAt DateTime?
  customerId                 String
  customer                   Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  accountId                  String?
  account                    Account?               @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status                     OrderStatus            @default(PENDING_PAYMENT)
  subtotalPaise              Int
  discountPaise              Int                    @default(0)
  shippingPaise              Int                    @default(0)
  taxPaise                   Int                    @default(0)
  totalPaise                 Int
  currency                   String                 @default("INR")
  couponCode                 String?
  shippingAddress            Json
  idempotencyKey             String                 @unique
  affiliateCode              String?
  attribution                Json?
  version                    Int                    @default(1)
  items                      OrderItem[]
  statusHistory              OrderStatusHistory[]
  notes                      OrderNote[]
  shipments                  Shipment[]
  payments                   Payment[]
  refunds                    Refund[]
  couponRedemptions          CouponRedemption[]
  sourceOrders               SourceOrder[]
  reservations               InventoryReservation[]
  checkoutOperation          CheckoutOperation?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([accountId, createdAt])
}

model OrderItem {
  id             String                @id @default(cuid())
  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId      String
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName    String
  sku            String
  color          String
  size           String
  quantity       Int
  unitPricePaise Int
  discountPaise  Int                   @default(0)
  totalPaise     Int
  reservation    InventoryReservation?
}

model CheckoutOperation {
  id                     String                 @id @default(cuid())
  operationType          String                 @default("CHECKOUT")
  idempotencyKey         String
  requestHash            String
  state                  CheckoutOperationState @default(PROCESSING)
  orderId                String?                @unique
  order                  Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  safeResponse           Json?
  providerOrderId        String?                @unique
  providerIdempotencyKey String                 @unique
  paymentCapability      String?
  failureCode            String?
  failureMessage         String?
  retryCount             Int                    @default(0)
  expiresAt              DateTime
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([operationType, idempotencyKey])
  @@index([state, expiresAt])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?
  adminUserId String?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderNote {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  body        String
  adminUserId String
  createdAt   DateTime @default(now())
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  courier        String
  trackingNumber String?
  trackingUrl    String?
  status         String
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Payment {
  id                     String                @id @default(cuid())
  orderId                String
  order                  Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider               String                @default("CASHFREE")
  providerOrderId        String                @unique
  status                 PaymentStatus         @default(CREATED)
  amountPaise            Int
  currency               String                @default("INR")
  providerIdempotencyKey String                @unique
  paymentSessionId       String?
  providerResponse       Json?
  attempts               PaymentAttempt[]
  webhooks               PaymentWebhookEvent[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([orderId, status])
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  paymentId         String
  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerPaymentId String?
  status            PaymentStatus
  amountPaise       Int
  response          Json?
  createdAt         DateTime      @default(now())

  @@index([paymentId, createdAt])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  paymentId       String?
  payment         Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  providerEventId String    @unique
  type            String
  signatureValid  Boolean
  payload         Json
  processedAt     DateTime?
  error           String?
  receivedAt      DateTime  @default(now())
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  providerRefundId String?      @unique
  idempotencyKey   String       @unique
  amountPaise      Int
  reason           String
  status           RefundStatus @default(CREATED)
  response         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId, status])
}

model Coupon {
  id                   String             @id @default(cuid())
  code                 String             @unique
  type                 String
  value                Int
  minimumOrderPaise    Int?
  maximumDiscountPaise Int?
  usageLimit           Int?
  perCustomerLimit     Int?
  startsAt             DateTime?
  endsAt               DateTime?
  active               Boolean            @default(true)
  redemptions          CouponRedemption[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId    String
  discountPaise Int
  createdAt     DateTime @default(now())

  @@unique([couponId, orderId])
}

model SourceOrder {
  id               String        @id @default(cuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourceId         String
  source           ProductSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  supplierOrderRef String?
  costPaise        Int?
  status           String
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Campaign {
  id          String                @id @default(cuid())
  slug        String                @unique
  name        String
  description String?
  status      String                @default("DRAFT")
  startAt     DateTime
  endAt       DateTime
  hero        Json?
  products    CampaignProduct[]
  collections CampaignCollection[]
  attribution CampaignAttribution[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model CampaignProduct {
  campaignId String
  productId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@id([campaignId, productId])
}

model CampaignCollection {
  campaignId   String
  collectionId String
  campaign     Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([campaignId, collectionId])
}

model Review {
  id               String        @id @default(cuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating           Int
  title            String
  text             String
  status           ReviewStatus  @default(PENDING)
  verifiedPurchase Boolean       @default(false)
  featured         Boolean       @default(false)
  displayName      String
  displayConsent   Boolean
  fitFeedback      String?
  purchasedSize    String?
  helpfulCount     Int           @default(0)
  media            ReviewMedia[]
  replies          ReviewReply[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([productId, status, createdAt])
}

model ReviewMedia {
  id        String @id @default(cuid())
  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  publicId  String @unique
  secureUrl String
  position  Int    @default(0)
}

model ReviewReply {
  id          String   @id @default(cuid())
  reviewId    String
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  body        String
  adminUserId String
  createdAt   DateTime @default(now())
}

model ReviewToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  orderItemId String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String
  consent        Boolean
  active         Boolean   @default(true)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model SupportTicket {
  id            String   @id @default(cuid())
  name          String
  email         String
  orderNumber   String?
  category      String?
  message       String
  status        String   @default("OPEN")
  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AnalyticsSession {
  id             String           @id
  sessionKey     String           @unique
  visitorKey     String
  firstSeenAt    DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  deviceCategory String?
  events         AnalyticsEvent[]
}

model AnalyticsEvent {
  id             String           @id @default(cuid())
  eventId        String?          @unique
  sessionId      String
  session        AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name           String
  occurredAt     DateTime
  productId      String?
  product        Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId        String?
  campaignId     String?
  pagePath       String
  deviceCategory String
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([name, occurredAt])
  @@index([productId, occurredAt])
}

model CampaignAttribution {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sessionId    String?
  orderId      String?
  source       String?
  medium       String?
  revenuePaise Int?
  createdAt    DateTime @default(now())

  @@index([campaignId, createdAt])
}

model DailyProductMetric {
  id           String   @id @default(cuid())
  date         DateTime
  productId    String
  views        Int      @default(0)
  addToCarts   Int      @default(0)
  purchases    Int      @default(0)
  revenuePaise Int      @default(0)

  @@unique([date, productId])
}

model DailyCollectionMetric {
  id           String   @id @default(cuid())
  date         DateTime
  collectionId String
  views        Int      @default(0)
  purchases    Int      @default(0)
  revenuePaise Int      @default(0)

  @@unique([date, collectionId])
}

model DailyCampaignMetric {
  id           String   @id @default(cuid())
  date         DateTime
  campaignId   String
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  orders       Int      @default(0)
  revenuePaise Int      @default(0)

  @@unique([date, campaignId])
}

model AnalyticsIngestionBatch {
  id               String   @id @default(cuid())
  accepted         Int
  rejected         Int
  rejectionSummary Json?
  createdAt        DateTime @default(now())
}

model NotificationTemplate {
  id               String                 @id @default(cuid())
  key              String                 @unique
  subject          String
  heading          String
  body             String
  enabled          Boolean                @default(true)
  securityCritical Boolean                @default(false)
  updatedAt        DateTime               @updatedAt
  deliveries       NotificationDelivery[]
}

model NotificationDelivery {
  id            String               @id @default(cuid())
  templateId    String
  template      NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipientHash String
  status        String               @default("QUEUED")
  attempts      Int                  @default(0)
  error         String?
  nextAttemptAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}
