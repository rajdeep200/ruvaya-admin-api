# Public origins (not secrets)
APP_URL=http://localhost:3001
STOREFRONT_URL=http://localhost:3000
STOREFRONT_ORIGIN=http://localhost:3000

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
STOREFRONT_REVALIDATION_SECRET=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruvaya
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ruvaya
AUTH_SECRET=
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=http://localhost:3000/payment/status?order_id={order_id}
CASHFREE_WEBHOOK_URL=http://localhost:3001/api/v1/webhooks/cashfree
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Product uploads are restricted in code to ruvaya/products/{productId}; images/video are limited to 25 MB.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=
ENCRYPTION_KEY=
CRON_SECRET=
LOG_LEVEL=info
